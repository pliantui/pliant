{
  "name": "www",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm schema:build && next dev --port 4000",
    "build": "pnpm registry:build && pnpm schema:build && next build && pnpm check:unfinished",
    "check:unfinished": "node scripts/check-unfinished.ts",
    "registry:build": "shadcn build",
    "schema:build": "node scripts/build-schema.ts",
    "replays:build": "node scripts/build-replays.ts",
    "start": "next start --port 4000",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p snippets",
    "lint": "next typegen && eslint --max-warnings 0 .",
    "lint:fix": "next typegen && eslint . --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "record": "pnpm --filter @pliantui/server build && node scripts/record.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@hookform/resolvers": "^7.0.7",
    "@pliantui/contract": "workspace:*",
    "@pliantui/core": "workspace:*",
    "@pliantui/react": "workspace:*",
    "@pliantui/server": "workspace:*",
    "@tanstack/react-table": "^9.3.1",
    "ai": "^7.0.173",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "fumadocs-core": "^16.19.0",
    "fumadocs-mdx": "^15.6.0",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "rehype-pretty-code": "^0.14.6",
    "server-only": "^0.0.1",
    "shiki": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opennextjs/cloudflare": "^1.20.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "~22.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
