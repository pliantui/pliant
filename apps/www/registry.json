{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "pliant",
  "homepage": "https://pliantui.dev",
  "items": [
    {
      "name": "pliant-region",
      "type": "registry:component",
      "title": "Pliant Region",
      "description": "A region whose slots users can reorder, hide, resize, wrap and collapse with Pliant overlays.",
      "dependencies": [
        "@pliantui/core",
        "@pliantui/react",
        "cn",
        "lucide-react",
        "zod"
      ],
      "registryDependencies": ["button"],
      "files": [
        {
          "path": "registry/pliant/pliant-region.tsx",
          "type": "registry:component",
          "target": "@components/pliant/pliant-region.tsx"
        }
      ]
    },
    {
      "name": "pliant-form",
      "type": "registry:component",
      "title": "Pliant Form",
      "description": "The fields of a form, which users can reorder, hide, collapse into a \"More fields\" section and give their own defaults with Pliant overlays.",
      "dependencies": ["@pliantui/react", "cn", "lucide-react"],
      "registryDependencies": ["button", "field"],
      "files": [
        {
          "path": "registry/pliant/pliant-form.tsx",
          "type": "registry:component",
          "target": "@components/pliant/pliant-form.tsx"
        }
      ]
    },
    {
      "name": "pliant-nav",
      "type": "registry:component",
      "title": "Pliant Nav",
      "description": "The links of a sidebar, which users can reorder, hide and collapse into a \"More\" item with Pliant overlays, pick their start page from, and keep open or closed.",
      "dependencies": ["@pliantui/react", "cn", "lucide-react"],
      "registryDependencies": ["dropdown-menu", "sidebar"],
      "files": [
        {
          "path": "registry/pliant/pliant-nav.tsx",
          "type": "registry:component",
          "target": "@components/pliant/pliant-nav.tsx"
        }
      ]
    },
    {
      "name": "pliant-ask-panel",
      "type": "registry:component",
      "title": "Pliant Ask Panel",
      "description": "A panel for asking AI to change how part of a page looks, with a preview that is only saved on Lock in.",
      "dependencies": [
        "@pliantui/react",
        "cn",
        "lucide-react",
        "radix-ui",
        "zod"
      ],
      "registryDependencies": [
        "badge",
        "button",
        "label",
        "select",
        "skeleton",
        "textarea"
      ],
      "files": [
        {
          "path": "registry/pliant/pliant-ask-panel.tsx",
          "type": "registry:component",
          "target": "@components/pliant/pliant-ask-panel.tsx"
        }
      ]
    },
    {
      "name": "pliant-point-mode",
      "type": "registry:component",
      "title": "Pliant Point Mode",
      "description": "A mode for pointing at the part of a page to change: hold Alt, press \u2318. or use the toggle, and the targets light up.",
      "dependencies": ["@pliantui/react", "cn", "lucide-react", "radix-ui"],
      "registryDependencies": ["button"],
      "files": [
        {
          "path": "registry/pliant/pliant-point-mode.tsx",
          "type": "registry:component",
          "target": "@components/pliant/pliant-point-mode.tsx"
        }
      ]
    },
    {
      "name": "pliant-data-table",
      "type": "registry:component",
      "title": "Pliant Data Table",
      "description": "A data table for usePliantTable with sortable headers, grouped rows that expand, aggregate totals, derived columns, a column menu and pagination.",
      "dependencies": [
        "@pliantui/react",
        "@tanstack/react-table",
        "cn",
        "lucide-react"
      ],
      "registryDependencies": ["button", "dropdown-menu", "table"],
      "files": [
        {
          "path": "registry/pliant/pliant-data-table.tsx",
          "type": "registry:component",
          "target": "@components/pliant/pliant-data-table.tsx"
        },
        {
          "path": "registry/pliant/pliant-data-table-column-header.tsx",
          "type": "registry:component",
          "target": "@components/pliant/pliant-data-table-column-header.tsx"
        },
        {
          "path": "registry/pliant/pliant-data-table-view-options.tsx",
          "type": "registry:component",
          "target": "@components/pliant/pliant-data-table-view-options.tsx"
        },
        {
          "path": "registry/pliant/pliant-data-table-pagination.tsx",
          "type": "registry:component",
          "target": "@components/pliant/pliant-data-table-pagination.tsx"
        },
        {
          "path": "registry/pliant/pliant-data-table-features.ts",
          "type": "registry:lib",
          "target": "@components/pliant/pliant-data-table-features.ts"
        },
        {
          "path": "registry/pliant/pliant-data-table-format.ts",
          "type": "registry:lib",
          "target": "@components/pliant/pliant-data-table-format.ts"
        }
      ]
    }
  ]
}
