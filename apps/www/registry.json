{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "pliant",
  "homepage": "https://pliantui-www.pliantui-dev.workers.dev",
  "items": [
    {
      "name": "customize-icon",
      "type": "registry:component",
      "title": "Customize Icon",
      "description": "The Customize icon, outline by default and filled for emphasis, with the same props as a lucide-react icon.",
      "files": [
        {
          "path": "registry/pliant/customize-icon.tsx",
          "type": "registry:component",
          "target": "@components/pliant/customize-icon.tsx"
        }
      ]
    },
    {
      "name": "pliant-customize-menu",
      "type": "registry:component",
      "title": "Pliant Customize Menu",
      "description": "The Customize menu that holds a part's Pliant actions (Ask for a change, Adjust by hand, History and Reset to default) as a header button, a right-click group and a command menu group, with ⌘. to ask about the focused part.",
      "dependencies": ["@pliantui/react", "cn", "lucide-react"],
      "registryDependencies": [
        "button",
        "command",
        "context-menu",
        "dropdown-menu",
        "https://pliantui.dev/r/customize-icon.json"
      ],
      "files": [
        {
          "path": "registry/pliant/pliant-customize-menu.tsx",
          "type": "registry:component",
          "target": "@components/pliant/pliant-customize-menu.tsx"
        }
      ]
    },
    {
      "name": "pliant-region",
      "type": "registry:component",
      "title": "Pliant Region",
      "description": "A region whose slots users can reorder, hide, resize, wrap and collapse with Pliant overlays.",
      "dependencies": [
        "@pliantui/core",
        "@pliantui/react",
        "cn",
        "lucide-react",
        "zod"
