{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pliantui-www",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Nothing on the site reads this variable. It stays set, off, to match
  // the worker's deployed settings. Previews don't inherit `vars`.
  "vars": {
    "PLIANT_ASK_ENABLED": "0",
  },
  "previews": {
    "vars": {
      "PLIANT_ASK_ENABLED": "0",
    },
  },
}
