{
  "name": "pliant",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm lint:root",
    "lint:root": "eslint --max-warnings 0 \"*.{js,mjs,cjs}\" .github",
    "lint:fix": "turbo run lint:fix && eslint --fix \"*.{js,mjs,cjs}\" .github",
    "typecheck": "turbo run typecheck",
    "format:check": "prettier --check . --cache",
    "format:write": "prettier --write . --cache",
    "check": "turbo run lint typecheck && pnpm lint:root && pnpm format:check && manypkg check",
    "check:packages": "turbo run check:package size --filter=./packages/*",
    "test": "turbo run test",
    "changeset": "changeset"
  },
  "packageManager": "pnpm@10.33.4",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@manypkg/cli": "^0.25.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "~22.12.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-turbo": "^2.11.10",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
