{
  "name": "@pliantui/contract",
  "version": "0.0.0",
  "private": true,
  "description": "Schemas, types and the op catalog for Pliant overlays.",
  "homepage": "https://github.com/pliantui/pliant#readme",
  "bugs": "https://github.com/pliantui/pliant/issues",
  "license": "MIT",
  "author": {
    "name": "Hitesh Shivkumar",
    "url": "https://github.com/TFM-HITESH"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pliantui/pliant.git",
    "directory": "packages/contract"
  },
  "keywords": [
    "pliant",
    "overlay",
    "schema",
    "shadcn"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/*.json": "./schema/*.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "size": "size-limit",
    "generate:schema": "vitest run --update src/json-schema.test.ts --testNamePattern \"matches the published file\""
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 kB",
      "ignore": [
        "zod"
      ]
    }
  ],
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "~22.12.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
