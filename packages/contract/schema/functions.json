            "datetime"
          ]
        }
      ],
      "returns": {
        "like": "x"
      },
      "unit": {
        "like": "x"
      },
      "nulls": "skip",
      "mergeable": null,
      "describe": "The value of x in the group's first row with one, in display order. Null when there are no values."
    },
    "last": {
      "kind": "aggregate",
      "args": [
        {
          "name": "x",
          "type": [
            "number",
            "string",
            "boolean",
            "date",
            "datetime"
          ]
        }
      ],
      "returns": {
        "like": "x"
      },
      "unit": {
        "like": "x"
      },
      "nulls": "skip",
      "mergeable": null,
      "describe": "The value of x in the group's last row with one, in display order. Null when there are no values."
    },
    "rank": {
      "kind": "window",
      "args": [
        {
          "name": "x",
          "type": [
            "number",
            "string",
            "date",
            "datetime"
          ]
        },
        {
          "name": "order",
          "type": "string",
          "optional": true,
          "default": "desc",
          "values": [
            "desc",
            "asc"
          ]
        }
      ],
      "returns": "integer",
      "unit": "none",
      "nulls": "skip",
      "mergeable": null,
      "describe": "1 plus the number of rows in the partition whose x comes before this row's, largest first unless order is asc. Ties share a rank and leave gaps (1, 2, 2, 4)."
    },
    "denseRank": {
      "kind": "window",
      "args": [
        {
          "name": "x",
          "type": [
            "number",
            "string",
            "date",
            "datetime"
          ]
        },
        {
          "name": "order",
          "type": "string",
          "optional": true,
          "default": "desc",
          "values": [
            "desc",
            "asc"
          ]
        }
      ],
      "returns": "integer",
      "unit": "none",
      "nulls": "skip",
      "mergeable": null,
      "describe": "1 plus the number of distinct values of x in the partition that come before this row's, largest first unless order is asc. Ties share a rank without gaps (1, 2, 2, 3)."
    },
    "runningSum": {
      "kind": "window",
      "args": [
        {
          "name": "x",
          "type": "number"
        }
      ],
      "returns": {
        "like": "x"
      },
      "unit": {
        "like": "x"
      },
      "nulls": "skip",
      "mergeable": null,
      "describe": "The sum of x over the partition's rows up to and including this one, one row at a time in display order, so tied rows get different sums."
    },
    "share": {
      "kind": "window",
      "args": [
        {
          "name": "x",
          "type": "number"
        }
      ],
      "returns": "number",
      "unit": "percent",
      "nulls": "skip",
      "mergeable": null,
      "describe": "x divided by the sum of x over the partition, or null when that sum is 0."
    },
    "zScore": {
      "kind": "window",
      "args": [
        {
          "name": "x",
          "type": "number"
        }
      ],
      "returns": "number",
      "unit": "none",
      "nulls": "skip",
      "mergeable": null,
      "describe": "(x - mean) divided by the sample standard deviation over the partition, or null when the deviation is 0 or there are fewer than 2 values."
    }
