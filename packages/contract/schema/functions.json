      "kind": "aggregate",
      "args": [
        {
          "name": "x",
          "type": "number"
        }
      ],
      "returns": "number",
      "unit": {
        "like": "x"
      },
      "nulls": "skip",
      "mergeable": null,
      "describe": "percentile(x, 0.5)."
