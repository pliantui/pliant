            "datetime"
          ]
        }
      ],
      "returns": "integer",
      "unit": "none",
      "nulls": "propagate",
      "mergeable": null,
      "describe": "dateDiff(date, today(), years)."
    },
    "count": {
      "kind": "aggregate",
      "args": [
