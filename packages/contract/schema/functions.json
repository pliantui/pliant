        "like": "x"
      },
      "unit": {
        "like": "x"
      },
      "nulls": "skip",
      "mergeable": [
        "sum"
      ],
      "describe": "The sum of x over rows where condition is true, or 0 when there are none."
    },
    "mean": {
      "kind": "aggregate",
      "args": [
        {
          "name": "x",
