        }
      ],
      "returns": "number",
      "unit": {
        "like": "x"
      },
      "nulls": "skip",
      "mergeable": [
        "count",
        "mean",
        "m2"
      ],
      "describe": "The sample standard deviation of x (dividing by n - 1), or null with fewer than 2 values."
    },
    "variancePop": {
      "kind": "aggregate",
      "args": [
        {
          "name": "x",
          "type": "number"
        }
      ],
      "returns": "number",
      "unit": "none",
      "nulls": "skip",
      "mergeable": [
        "count",
        "mean",
        "m2"
      ],
      "describe": "The population variance of x (dividing by n), or null when there are no values."
    },
    "stddevPop": {
      "kind": "aggregate",
      "args": [
        {
          "name": "x",
          "type": "number"
        }
      ],
      "returns": "number",
      "unit": {
        "like": "x"
      },
      "nulls": "skip",
      "mergeable": [
        "count",
        "mean",
        "m2"
      ],
      "describe": "The population standard deviation of x (dividing by n), or null when there are no values."
