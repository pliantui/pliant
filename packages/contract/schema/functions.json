    "percentile": {
      "kind": "aggregate",
      "args": [
        {
          "name": "x",
          "type": "number"
        },
        {
          "name": "p",
          "type": "number",
          "constant": true,
          "range": [
            0,
            1
          ]
        }
      ],
      "returns": "number",
      "unit": {
        "like": "x"
      },
      "nulls": "skip",
      "mergeable": null,
      "describe": "The p quantile of x: with the n values sorted, the value at position p × (n - 1) counting from 0, interpolated linearly between neighbours. Null when there are no values."
    },
    "mode": {
      "kind": "aggregate",
      "args": [
        {
          "name": "x",
          "type": [
            "number",
            "string",
            "boolean",
