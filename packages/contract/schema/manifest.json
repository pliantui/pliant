{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pliantui.dev/schema/manifest.json",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:[a-z][a-z0-9]*(?:-[a-z0-9]+)*:)?[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "not": {
        "pattern": "^pliant:"
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "props": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "values": {
                "minItems": 1,
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "uniqueItems": true
              },
              "default": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "semantic": {
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "uniqueItems": true
              },
              "description": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "values"
            ],
            "additionalProperties": false
          }
        },
        "label": {
          "type": "boolean"
        },
        "hideable": {
          "type": "boolean"
        },
        "slots": {
          "type": "boolean"
        },
        "layout": {
          "type": "boolean"
        },
        "insertable": {
          "type": "boolean"
        },
        "form": {
          "type": "boolean"
        },
        "presentation": {
          "type": "boolean"
        },
        "nav": {
          "type": "boolean"
        },
        "actions": {
          "type": "boolean"
        },
        "data": {
          "type": "boolean"
        },
        "defaults": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "values": {
                    "anyOf": [
                      {
                        "minItems": 1,
                        "maxItems": 32,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "uniqueItems": true
                      },
                      {
                        "minItems": 1,
                        "maxItems": 32,
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "uniqueItems": true
                      }
                    ]
                  },
                  "persist": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "values"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "boolean"
                  },
                  "persist": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "number"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "persist": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "min",
                  "max"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "date"
                  },
                  "persist": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "version",
    "description",
    "capabilities"
  ],
  "additionalProperties": false,
  "title": "Pliant manifest",
  "description": "What a component lets users change."
}
