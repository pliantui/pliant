{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "props": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "values": {
                "minItems": 1,
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "default": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "semantic": {
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "description": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "values"
            ]
          }
        },
        "label": {
          "type": "boolean"
        },
        "hideable": {
          "type": "boolean"
        },
        "slots": {
          "type": "boolean"
        },
        "layout": {
          "type": "boolean"
        },
        "insertable": {
          "type": "boolean"
        },
        "form": {
          "type": "boolean"
        },
        "presentation": {
          "type": "boolean"
        },
        "nav": {
          "type": "boolean"
        },
        "actions": {
          "type": "boolean"
        },
        "data": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "kind",
    "version",
    "description",
    "capabilities"
  ]
}
