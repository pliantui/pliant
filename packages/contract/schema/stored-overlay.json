      "title": "Pliant overlay",
      "description": "A set of ops one layer applies to a surface. This schema checks the overlay but not its ops: check each op on its own against op.json and catalog.json, following the steps in the @pliantui/contract README. When loading, apply only valid ops and keep the others unchanged; reject an AI answer or import unless every op is valid."
    },
    "etag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Opaque: compare it only for equality."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "The adapter increases it on every save. For a team or org overlay it is the version that basis.layers records, and clients compare versions to tell that a layer changed."
    },
