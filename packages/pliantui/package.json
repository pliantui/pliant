{
  "name": "pliantui",
  "version": "0.0.1",
  "description": "Make your shadcn app reshapeable by its users.",
  "homepage": "https://github.com/pliantui/pliant#readme",
  "bugs": "https://github.com/pliantui/pliant/issues",
  "license": "MIT",
  "author": {
    "name": "Hitesh Shivkumar",
    "url": "https://github.com/TFM-HITESH"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pliantui/pliant.git",
    "directory": "packages/pliantui"
  },
  "keywords": [
    "pliant",
    "shadcn",
    "cli",
    "components"
  ],
  "type": "module",
  "bin": {
    "pliantui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "check:package": "publint --strict",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "~22.12.0",
    "eslint": "^9.39.5",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
