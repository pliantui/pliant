{
  "name": "@pliantui/react",
  "version": "0.0.0",
  "private": true,
  "description": "React bindings for Pliant: the provider, the layer store and hooks.",
  "homepage": "https://github.com/pliantui/pliant#readme",
  "bugs": "https://github.com/pliantui/pliant/issues",
  "license": "MIT",
  "author": {
    "name": "Hitesh Shivkumar",
    "url": "https://github.com/TFM-HITESH"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pliantui/pliant.git",
    "directory": "packages/react"
  },
  "keywords": [
    "pliant",
    "overlay",
    "shadcn",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./region": {
      "types": "./dist/region.d.ts",
      "default": "./dist/region.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "default": "./dist/table.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "default": "./dist/local.js"
    },
    "./server-adapter": {
      "types": "./dist/server-adapter.d.ts",
      "default": "./dist/server-adapter.js"
    },
    "./ask": {
      "types": "./dist/ask.d.ts",
      "default": "./dist/ask.js"
    },
    "./point-mode": {
      "types": "./dist/point-mode.d.ts",
      "default": "./dist/point-mode.js"
    },
    "./pre-paint": {
      "types": "./dist/pre-paint.d.ts",
      "default": "./dist/pre-paint.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "size": "size-limit"
  },
  "dependencies": {
    "@pliantui/contract": "workspace:*",
    "@pliantui/core": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^9.3.1",
    "react": "^19.2.0",
    "zod": "^4.0.16"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tanstack/react-table": "^9.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "~22.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
