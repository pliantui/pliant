{
  "name": "@pliantui/server",
  "version": "0.0.0",
  "private": true,
  "description": "Server handler, datasets and AI pipeline for Pliant.",
  "homepage": "https://github.com/pliantui/pliant#readme",
  "bugs": "https://github.com/pliantui/pliant/issues",
  "license": "MIT",
  "author": {
    "name": "Hitesh Shivkumar",
    "url": "https://github.com/TFM-HITESH"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pliantui/pliant.git",
    "directory": "packages/server"
  },
  "keywords": [
    "pliant",
    "ai",
    "shadcn",
    "server"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "~22.12.0",
    "eslint": "^10.13.0",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
