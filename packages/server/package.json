{
  "name": "@pliantui/server",
  "version": "0.0.0",
  "private": true,
  "description": "Server handler, datasets and AI pipeline for Pliant.",
  "homepage": "https://github.com/pliantui/pliant#readme",
  "bugs": "https://github.com/pliantui/pliant/issues",
  "license": "MIT",
  "author": {
    "name": "Hitesh Shivkumar",
    "url": "https://github.com/TFM-HITESH"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pliantui/pliant.git",
    "directory": "packages/server"
  },
  "keywords": [
    "pliant",
    "ai",
    "shadcn",
    "server"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "default": "./dist/data.js"
    },
    "./recordings": {
      "types": "./dist/recordings.d.ts",
      "default": "./dist/recordings.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "size": "size-limit"
  },
  "dependencies": {
    "@pliantui/contract": "workspace:*",
    "@pliantui/core": "workspace:*"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "~22.12.0",
    "ai": "^7.0.177",
    "eslint": "^9.39.5",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
